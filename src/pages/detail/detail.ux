<template>
  <div class="container">
    <!-- 返回按钮 -->
    <img
      class="leftButton top"
      src="/common/images/back.png"
      @click="goBack"
      static
    />
    <!-- 时间 -->
    <text class="time">{{ currentTime }}</text>
    <!-- 标题 -->
    <text class="title" static>
      <span>关于</span>
    </text>

    <div style="height: 6px;"></div>

    <!-- 加载占位（首帧先就位） -->
    <div class="content-loading" if="{{!loaded}}">
      <text class="content-loading__text" static>加载中...</text>
    </div>

    <!-- 滚动容器 -->
    <div class="box" if="{{loaded}}">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <!-- 内容卡片 -->
        <div class="detail-item">
          <div class="detail-card">
            <text class="detail-title">闪念小抄</text>
            <text class="detail-version">版本 1.0.0</text>
            <text class="detail-desc">高中知识点速记工具</text>
            <text class="detail-desc">随时随地，轻松学习</text>

            <text class="detail-slogan">「闪念之间，知识即现」</text>

            <div class="detail-divider"></div>

            <div class="detail-developer-row">
              <img src="/common/images/avatar.png" class="detail-avatar" />
              <text class="detail-developer">开发者 @文华逸洋</text>
            </div>

            <div class="detail-divider detail-divider--thin"></div>

            <!-- 键盘震动设置:胶囊按钮风格(同 import 页按钮)。总开关开→''关闭;
                 开时下方出现「震动时长」行(一个按钮短/长切换,点击即试振)。切换即写 $def + storage。 -->
            <div class="detail-vib">
              <div class="detail-vib__row" @click="toggleVibrateOn">
                <div class="detail-vib__left">
                  <text class="detail-vib__title">键盘震动</text>
                  <text class="detail-vib__hint">按键时震动反馈</text>
                </div>
                <text class="detail-vib__btn {{ vibrateOn ? 'detail-vib__btn--on' : '' }}">{{ vibrateOn ? '开' : '关' }}</text>
              </div>

              <!-- 时长行:总开关开才出现;单按钮在 短震/长震 间切换 -->
              <div class="detail-vib__row" if="{{vibrateOn}}">
                <div class="detail-vib__left">
                  <text class="detail-vib__title">震动时长</text>
                  <text class="detail-vib__hint">短=轻/长=重</text>
                </div>
                <text class="detail-vib__btn detail-vib__btn--on" @click="toggleVibrateLong">{{ vibrateLong ? '长震' : '短震' }}</text>
              </div>
            </div>

            <div class="detail-divider detail-divider--thin"></div>

            <!-- 导入知识点入口:interconnect 接收页(真接收手机端推送 + 本地自验) -->
            <div class="detail-extra" @click="goImport">
              <text class="detail-extra__title">导入知识点</text>
              <text class="detail-extra__hint">手机端推送 / 本地自验导入</text>
            </div>
          </div>
        </div>

        <!-- 底部占位 -->
        <div class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import { onTimeChange, offTimeChange } from '../../common/clock'

export default {
  private: {
    loaded: false,
    currentTime: "00:00",
    vibrateOn: false,     // 键盘震动总开关(对应 vibratemode '' vs 'short'/'long')
    vibrateLong: false    // 细分:长振开关(开='long',关='short');总开关关时置灰
  },

  onInit() {
    this.__unsubClock = onTimeChange((t) => { this.currentTime = t })
    // 初始读回震动设置:$def 缓存(启动时 app.ux 已从 storage 读回)。
    // 竞态兜底:若本页先于 app 异步读回,订阅 vibrate-loaded 广播后刷新。
    this._applyVibrateFromStore()
    this.__unsubVibrate = this.$app.$def.onReceive((ev) => {
      if (ev && ev.kind === 'vibrate-loaded') this._applyVibrateFromStore()
    })
    // 内容是单张静态卡,数据无;loaded=false 让 scroll 不进 DOM,首帧只画标题+占位。
    // 50ms 后切 loaded=true 渲染卡片,让标题先就位,进页顺滑。
    setTimeout(() => {
      this.loaded = true
    }, 50)
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
    }
    if (this.__unsubVibrate) {
      this.__unsubVibrate()
    }
  },

  // 读 $def 缓存到本页状态(vibratemode 三态映射:'long'→on+long,'short'→on+短,其他→off)。
  _applyVibrateFromStore() {
    const m = this.$app.$def.getKeyboardVibrateMode()
    this.vibrateOn = (m === 'short' || m === 'long')
    this.vibrateLong = (m === 'long')
  },

  // 把本页震动设置写回全局:总开关 off→'';on→'long'/'short';并持久化。
  _persistVibrate() {
    const mode = this.vibrateOn ? (this.vibrateLong ? 'long' : 'short') : ''
    this.$app.$def.setKeyboardVibrateMode(mode)
  },

  // 切换总开关:开用上次短/长设置;关直接清空。切后即时试振一下给用户反馈。
  toggleVibrateOn() {
    this.vibrateOn = !this.vibrateOn
    this._persistVibrate()
    if (this.vibrateOn) {
      try { vibrator.vibrate({ mode: this.vibrateLong ? 'long' : 'short' }) } catch (e) {}
    }
  },

  // 切换时长:短震/长震互斥(单按钮切换)。时长行仅在总开关开时显示,但此处仍兜底校验。
  toggleVibrateLong() {
    if (!this.vibrateOn) return
    this.vibrateLong = !this.vibrateLong
    this._persistVibrate()
    try { vibrator.vibrate({ mode: this.vibrateLong ? 'long' : 'short' }) } catch (e) {}
  },

  goBack() {
    router.back()
  },

  // 跳转导入页:interconnect 接收 + 本地自验都在那页。
  goImport() {
    router.push({ uri: '/pages/import' })
  },

  // 加载预制示例扩展包 sample（走 import .js 路线，详见 knowledgeStore.js 注释）。
  // store.loadExtraByName 同步把包并入 $app.$def.store 的 userSubjects；
  // 成功后返回 index，onShow 重读 getSubjects 即可看到「拓展物理」置底带「导入」角标。
  loadExtraSample() {
    prompt.showToast({ message: '加载中...', duration: 800 })
    this.$app.$def.store.loadExtraByName('sample', (res) => {
      if (res && res.ok) {
        prompt.showToast({ message: '已加载示例扩展包', duration: 1500 })
        return
      }
      const reason = (res && res.reason) ? res.reason : 'fail'
      let msg = '加载失败:' + reason
      if (reason === 'no-reg') msg = '示例包未注册'
      prompt.showToast({ message: msg, duration: 2000 })
    })
  }
}
</script>

