<template>
  <div class="container">
    <!-- 返回按钮 -->
    <img
      class="leftButton top"
      src="/common/images/back.png"
      @click="goBack"
      static
    />
    <!-- 时间 -->
    <text class="time">{{ currentTime }}</text>
    <!-- 标题 -->
    <text class="title" static>
      <span>关于</span>
    </text>

    <div style="height: 6px;"></div>

    <!-- 加载占位（首帧先就位） -->
    <div class="content-loading" if="{{!loaded}}">
      <text class="content-loading__text" static>加载中...</text>
    </div>

    <!-- 滚动容器 -->
    <div class="box" if="{{loaded}}">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <!-- 内容卡片 -->
        <div class="detail-item">
          <div class="detail-card">
            <text class="detail-title">闪念小抄</text>
            <text class="detail-version">版本 1.0.0</text>
            <text class="detail-desc">高中知识点速记工具</text>
            <text class="detail-desc">随时随地，轻松学习</text>

            <text class="detail-slogan">「闪念之间，知识即现」</text>

            <div class="detail-divider"></div>

            <div class="detail-developer-row">
              <img src="/common/images/avatar.png" class="detail-avatar" />
              <text class="detail-developer">开发者 @文华逸洋</text>
            </div>

            <div class="detail-divider detail-divider--thin"></div>

            <!-- 导入知识点入口:interconnect 接收页(真接收手机端推送 + 本地自验) -->
            <div class="detail-extra" @click="goImport">
              <text class="detail-extra__title">导入知识点</text>
              <text class="detail-extra__hint">手机端推送 / 本地自验导入</text>
            </div>
          </div>
        </div>

        <!-- 底部占位 -->
        <div class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { onTimeChange, offTimeChange } from '../../common/clock'

export default {
  private: {
    loaded: false,
    currentTime: "00:00"
  },

  onInit() {
    this.__unsubClock = onTimeChange((t) => { this.currentTime = t })
    // 内容是单张静态卡,数据无;loaded=false 让 scroll 不进 DOM,首帧只画标题+占位。
    // 50ms 后切 loaded=true 渲染卡片,让标题先就位,进页顺滑。
    setTimeout(() => {
      this.loaded = true
    }, 50)
  },

  onDestroy() {
    if (this.__unsubClock) {
      offTimeChange(this.__unsubClock)
    }
  },

  goBack() {
    router.back()
  },

  // 跳转导入页:interconnect 接收 + 本地自验都在那页。
  goImport() {
    router.push({ uri: '/pages/import' })
  },

  // 加载预制示例扩展包 sample（走 import .js 路线，详见 knowledgeStore.js 注释）。
  // store.loadExtraByName 同步把包并入 $app.$def.store 的 userSubjects；
  // 成功后返回 index，onShow 重读 getSubjects 即可看到「拓展物理」置底带「导入」角标。
  loadExtraSample() {
    prompt.showToast({ message: '加载中...', duration: 800 })
    this.$app.$def.store.loadExtraByName('sample', (res) => {
      if (res && res.ok) {
        prompt.showToast({ message: '已加载示例扩展包', duration: 1500 })
        return
      }
      const reason = (res && res.reason) ? res.reason : 'fail'
      let msg = '加载失败:' + reason
      if (reason === 'no-reg') msg = '示例包未注册'
      prompt.showToast({ message: msg, duration: 2000 })
    })
  }
}
</script>

